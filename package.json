{
  "name": "flexible-hotels-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for searching hotel offers by flexible date windows and number of nights (instead of fixed check-in/check-out dates). Works with no API key (free Booking.com links) or with an optional StayAPI key for real live prices.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "flexible-hotels-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
