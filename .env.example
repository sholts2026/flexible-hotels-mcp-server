# Get a free API key (no credit card required) at https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret

# "test" (free sandbox, default) or "production" (paid, real-time data)
AMADEUS_ENV=test

# stdio (default, for Claude Desktop / local MCP clients) or http (remote server)
TRANSPORT=stdio
PORT=3000

# Optional: your Booking.com Partner "aid" value (free self-serve signup at
# https://www.booking.com/affiliate-program) — appended to every booking link so
# you earn a commission on completed bookings. The server works fine without it;
# links just won't be tracked/monetized.
BOOKING_AFFILIATE_ID=
